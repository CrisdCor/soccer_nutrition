# Supabase (proyecto: borxeontmmautjxcxmiq — us-east-1)
# La anon key es pública y está protegida por Row Level Security en todas las tablas,
# por lo que es segura de exponer en el bundle del cliente y en variables de Vercel.
# Cópiala desde Project Settings > API en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key: NUNCA pública, NUNCA con prefijo NEXT_PUBLIC_ (bypassa RLS
# por completo). Solo se usa en servidor (lib/supabase/admin.ts) para el
# módulo de Usuarios (Admin API: crear/inactivar usuarios). Cópiala desde
# Project Settings > API > service_role secret, y agrégala también como
# variable de entorno en Vercel (Production + Preview) — no solo aquí.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
